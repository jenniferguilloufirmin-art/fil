#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"

usage() {
  cat <<'EOF'
Usage:
  aibi wireless [ipad|samsung|other]
  aibi wired    [ipad|samsung|other]
  aibi mirror   [ipad|iphone|samsung]
  aibi status
  aibi --help

Open the native display settings for connecting another screen.
The device name selects the instructions shown after the settings open.
EOF
}

die() {
  printf 'aibi: %s\n' "$1" >&2
  exit 2
}

open_macos_displays() {
  if ! command -v open >/dev/null 2>&1; then
    die "the macOS 'open' command is unavailable"
  fi
  open "x-apple.systempreferences:com.apple.Displays-Settings.extension"
}

open_linux_displays() {
  if command -v gnome-control-center >/dev/null 2>&1; then
    gnome-control-center display >/dev/null 2>&1 &
  elif command -v xfce4-display-settings >/dev/null 2>&1; then
    xfce4-display-settings >/dev/null 2>&1 &
  elif command -v arandr >/dev/null 2>&1; then
    arandr >/dev/null 2>&1 &
  else
    die "no supported display settings tool found (GNOME, XFCE, or ARandR)"
  fi
}

mirror_device() {
  local device="$1"

  case "$device" in
    samsung)
      command -v scrcpy >/dev/null 2>&1 ||
        die "scrcpy is required for Samsung mirroring (install it with: brew install scrcpy)"
      scrcpy
      ;;
    ipad|iphone)
      if [[ "$(uname -s)" != "Darwin" ]]; then
        die "iPad and iPhone mirroring is supported here only on macOS"
      fi
      osascript <<'APPLESCRIPT'
tell application "QuickTime Player"
  activate
  new movie recording
end tell
APPLESCRIPT
      printf '%s\n' "Fenêtre QuickTime ouverte. Sélectionnez l’iPad ou l’iPhone dans le menu caméra de cette fenêtre."
      ;;
    *)
      die "device must be ipad, iphone, or samsung"
      ;;
  esac
}

show_next_steps() {
  local mode="$1"
  local device="$2"

  printf '\nMode: %s | Appareil: %s\n' "$mode" "$device"
  case "$device" in
    ipad)
      if [[ "$mode" == "wireless" ]]; then
        printf '%s\n' "Dans Réglages Écrans, cliquez sur Ajouter un écran (+), puis choisissez l’iPad sous Recopier ou étendre."
        printf '%s\n' "L’iPad doit être compatible Sidecar, connecté au même compte Apple, avec le Wi-Fi, le Bluetooth et Handoff activés."
      else
        printf '%s\n' "Branchez l’iPad en USB, ouvrez Réglages Écrans, puis choisissez l’iPad dans Ajouter un écran (+)."
      fi
      ;;
    samsung)
      if [[ "$mode" == "wireless" ]]; then
        printf '%s\n' "macOS ne propose pas nativement une tablette Samsung comme second écran via Smart View."
        printf '%s\n' "Utilisez une application compatible installée sur le Mac et la tablette, puis suivez son appairage."
      else
        printf '%s\n' "Une tablette Samsung ne devient pas automatiquement un écran Mac avec un câble USB-C/HDMI."
        printf '%s\n' "Utilisez une application de second écran compatible ou un adaptateur prévu pour cet usage."
      fi
      ;;
    other)
      if [[ "$mode" == "wireless" ]]; then
        printf '%s\n' "Activez Miracast, Chromecast ou la recopie d’écran sur l’appareil, puis choisissez-le dans les réglages."
      else
        printf '%s\n' "Branchez le câble vidéo compatible, puis sélectionnez l’écran dans les réglages."
      fi
      ;;
  esac
  printf '%s\n' "Remarque : la diffusion sans fil dépend du protocole et du matériel pris en charge par l’ordinateur."
}

main() {
  local action="${1:-}"
  local device="${2:-other}"

  case "$action" in
    --help|-h)
      usage
      ;;
    --version|-v)
      printf '%s\n' "$VERSION"
      ;;
    status)
      printf 'aibi %s\n' "$VERSION"
      printf 'OS: %s\n' "$(uname -s)"
      if command -v system_profiler >/dev/null 2>&1; then
        printf 'Display hardware: available through system_profiler\n'
      elif command -v xrandr >/dev/null 2>&1; then
        printf 'Display hardware: available through xrandr\n'
      else
        printf 'Display hardware: native inspection tool not found\n'
      fi
      ;;
    mirror)
      [[ "$device" == "ipad" || "$device" == "iphone" || "$device" == "samsung" ]] ||
        die "device must be ipad, iphone, or samsung"
      mirror_device "$device"
      ;;
    wireless|wired)
      [[ "$device" == "ipad" || "$device" == "samsung" || "$device" == "other" ]] ||
        die "device must be ipad, samsung, or other"
      case "$(uname -s)" in
        Darwin) open_macos_displays ;;
        Linux) open_linux_displays ;;
        *) die "unsupported operating system: $(uname -s)" ;;
      esac
      show_next_steps "$action" "$device"
      ;;
    "")
      usage
      exit 2
      ;;
    *)
      die "unknown command '$action' (try: aibi --help)"
      ;;
  esac
}

main "$@"
